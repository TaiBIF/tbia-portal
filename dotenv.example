ENV=
DEBUG=False
MAINTENANCE_MODE=
SECRET_KEY=

# domain 相關(逗號分隔,不含空格;CSRF/CORS 需帶 https://)
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=
PORTAL_HOST=

STATIC_ROOT=
MEDIA_ROOT=
SOLR_PREFIX=

# 寄信服務(SES,可留空用 default)
AWS_SES_REGION_NAME=
AWS_SES_REGION_ENDPOINT=

# portal 資料庫
# 注意:DATABASE_URL 內的帳密需與下方 POSTGRES_* 一致
DATABASE_URL=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# datahub 資料庫
DATAHUB_POSTGRES_HOST=
DATAHUB_POSTGRES_USER=
DATAHUB_POSTGRES_PASSWORD=
DATAHUB_POSTGRES_PORT=
DATAHUB_POSTGRES_DB=

# ARK
ARK_NAAN=
TBIA_ARKLET_KEY=
TBIA_ARKLET_PUBLIC=
TBIA_ARKLET_INTERNAL=

# Cloudflare Turnstile(人機驗證)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 背景工作（django-q2 worker 容器）
# BG_HEAVY_WORKERS：同時產檔的工作數；BG_TASK_TIMEOUT：單一工作實際執行上限秒數（不含排隊）
# BG_LIGHT_WORKERS：web 內寄信／統計的執行緒數；BG_SYNC=True 時不經佇列直接執行（本機無 worker 時用）
BG_HEAVY_WORKERS=2
BG_TASK_TIMEOUT=86400
BG_LIGHT_WORKERS=4
BG_SYNC=False
